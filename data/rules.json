        {
          "id": "trading",
          "title": "Trading",
          "items": [
            {
              "id": "trading-draft-pick-trading",
              "depth": 0,
              "text": "Draft Pick Trading"
            },
            {
              "id": "trading-if-a-manager-trades-away-a",
              "depth": 1,
              "text": "If a manager trades away a draft pick, they must pay some or all of that year's entry fee:"
            },
            {
              "id": "trading-1st-round-pick-full-buy-in",
              "depth": 1,
              "text": "1st Round Pick: Full buy-in"
            },
            {
              "id": "trading-2nd-3rd-round-pick-half-buy",
              "depth": 1,
              "text": "2nd/3rd Round Pick: Half buy-in"
            },
            {
              "id": "trading-managers-can-trade-for-picks-in",
              "depth": 1,
              "text": "Managers can trade for picks in the current year and the following three years."
            },
            {
              "id": "trading-i-e-for-league-year-2025",
              "depth": 1,
              "text": "I.e. for league year 2025, managers can trade 2025 (current rookie draft), 2026, 2027, and 2028 picks."
            },
            {
              "id": "trading-conditional-trades-general-guidelines",
              "depth": 0,
              "text": "Conditional trades -- general guidelines"
            },
            {
              "id": "trading-managers-are-encouraged-to-call-their",
              "depth": 1,
              "text": "Managers are encouraged to \"call their shot.\" Use conditions to wager players, picks, or FAAB based on specific, measurable outcomes (e.g., \"If Player X scores 8+ TDs this season, Team A sends a 2026 3rd-round pick to Team B\")."
            },
            {
              "id": "trading-all-conditions-must-be-directly-tied",
              "depth": 1,
              "text": "All conditions must be directly tied to real-life football outcomes or fantasy performance. They must not rely on external or subjective factors (e.g., \"If I get a new job\" is not a valid condition)."
            },
            {
              "id": "trading-all-conditional-terms-must-be-submitted",
              "depth": 1,
              "text": "All conditional terms must be submitted to the commissioner in writing (chat, email, or league message board) at the time of the trade. Both parties must confirm the terms."
            },
            {
              "id": "trading-all-conditional-trades-must-be-approved",
              "depth": 1,
              "text": "All conditional trades must be approved by the commissioner to validate terms."
            },
            {
              "id": "trading-conditional-trades-asset-locking-restrictions",
              "depth": 0,
              "text": "Conditional trades -- asset locking & restrictions"
            },
            {
              "id": "trading-conditional-assets-players-picks-or-faab",
              "depth": 1,
              "text": "Conditional assets (players, picks, or FAAB that are \"on the line\" in a trade) will remain on the original manager's team until the condition is resolved."
            },
            {
              "id": "trading-these-conditional-assets-are-frozen-they",
              "depth": 1,
              "text": "These conditional assets are frozen. They may not be traded, dropped, or used in a separate condition until the original condition resolves."
            },
            {
              "id": "trading-conditional-trades-acceptable-examples",
              "depth": 0,
              "text": "Conditional trades -- acceptable examples"
            },
            {
              "id": "trading-if-jayden-daniels-finishes-as-a",
              "depth": 1,
              "text": "\"If Jayden Daniels finishes as a top-12 QB this season, I send a 2026 2nd.\""
            },
            {
              "id": "trading-if-malik-nabers-out-scores-jordan",
              "depth": 1,
              "text": "\"If Malik Nabers out-scores Jordan Addison rest-of-season (Weeks 7-17), I owe you $20 FAAB.\""
            },
            {
              "id": "trading-if-i-win-the-championship-and",
              "depth": 1,
              "text": "\"If I win the championship and Puka Nacua averages 20+ points per game over the playoff stretch, the 2026 2nd turns to a 2027 1st.\""
            },
            {
              "id": "trading-conditional-trades-disputes",
              "depth": 0,
              "text": "Conditional trades -- disputes"
            },
            {
              "id": "trading-if-a-dispute-arises-over-unclear",
              "depth": 1,
              "text": "If a dispute arises over unclear or ambiguous conditions, the commissioner will resolve it based on the original written record, the intent of the trade, and logic and fairness."
            },
            {
              "id": "trading-trade-deadline",
              "depth": 0,
              "text": "Trade Deadline"
            },
            {
              "id": "trading-trades-must-be-accepted-prior-to",
              "depth": 1,
              "text": "Trades must be accepted prior to the end of the final game in week 14 (per Sleeper restrictions)."
            },
            {
              "id": "trading-vetoes",
              "depth": 0,
              "text": "Vetoes"
            },
            {
              "id": "trading-this-is-a-no-veto-league",
              "depth": 1,
              "text": "This is a NO VETO league. Managers are expected to manage their teams intelligently and play with integrity. If a manager is found to have colluded, they will be banned from the league and will forfeit any entry fee payments made toward subsequent years."
            },
            {
              "id": "trading-if-a-manager-has-a-history",
              "depth": 1,
              "text": "If a manager has a history of egregious - albeit non-collusive - roster transactions, they may be asked to leave the league to maintain competitive fairness."
            }
          ]
        },
